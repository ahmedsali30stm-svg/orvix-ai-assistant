# ── Orvix configuration ─────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.

# AI brain (priority order): Groq first, then any OpenAI-compatible endpoint.
# Groq free tier: create a key at https://console.groq.com — generous free quota.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# For OpenAI instead of Groq, set:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
# For a local Ollama: OPENAI_BASE_URL=http://127.0.0.1:11434/v1  AI_MODEL=llama3.1

# Model router (blueprint §72): leave blank to use AI_MODEL for everything.
JARVIS_MODEL_FAST=
JARVIS_MODEL_REASONING=
JARVIS_MODEL_CODING=

# Local gateway HTTP port
PORT=8787

# Master key used to encrypt integration credentials at rest (openssl rand -hex 32).
# A default dev key is used when unset — set a real one for anything persistent.
JARVIS_MASTER_KEY=

# Session signing secret for the local desktop client.
JARVIS_SESSION_SECRET=

# Leave empty for the local demo user (single-user local mode).
JARVIS_AUTH_DISABLED=true

# Node environment
NODE_ENV=development
